-- CRT Shader for LÖVE
-- Adapted from Timothy Lottes' public domain CRT shader

return love.graphics.newShader([[
#ifdef PIXEL
uniform float hardScan;      // Hardness of scanline: -8.0 = soft, -16.0 = medium
uniform float hardPix;       // Hardness of pixels: -2.0 = soft, -4.0 = hard
uniform vec2 warp;           // Display warp: (1.0/32.0, 1.0/24.0) = slight, (1.0/16.0, 1.0/8.0) = extreme
uniform float maskDark;      // Shadow mask darkness
uniform float maskLight;     // Shadow mask lightness
uniform vec2 textureSize;    // Size of the input texture

// sRGB to Linear
float ToLinear1(float c) { return (c <= 0.04045) ? c/12.92 : pow((c+0.055)/1.055, 2.4); }
vec3 ToLinear(vec3 c) { return vec3(ToLinear1(c.r), ToLinear1(c.g), ToLinear1(c.b)); }

// Linear to sRGB
float ToSrgb1(float c) { return (c < 0.0031308) ? c*12.92 : 1.055*pow(c, 0.41666)-0.055; }
vec3 ToSrgb(vec3 c) { return vec3(ToSrgb1(c.r), ToSrgb1(c.g), ToSrgb1(c.b)); }

// Fetch texture sample at given position and offset
vec3 Fetch(vec2 pos, vec2 off, Image tex) {
    // We're using normalized coordinates (0-1) for LÖVE
    pos = pos + off / textureSize;
    return ToLinear(Texel(tex, pos).rgb);
}

// Distance in pixels to nearest texel
vec2 Dist(vec2 pos) {
    pos = pos * textureSize;
    return -((pos - floor(pos)) - vec2(0.5));
}

// 1D Gaussian
float Gaus(float pos, float scale) {
    return exp2(scale * pos * pos);
}

// 3-tap Gaussian filter along horizontal line
vec3 Horz3(vec2 pos, float off, Image tex) {
    vec3 b = Fetch(pos, vec2(-1.0, off), tex);
    vec3 c = Fetch(pos, vec2(0.0, off), tex);
    vec3 d = Fetch(pos, vec2(1.0, off), tex);
    float dst = Dist(pos).x;
    
    // Convert distance to weight
    float scale = hardPix;
    float wb = Gaus(dst - 1.0, scale);
    float wc = Gaus(dst + 0.0, scale);
    float wd = Gaus(dst + 1.0, scale);
    
    // Return filtered sample
    return (b*wb + c*wc + d*wd) / (wb + wc + wd);
}

// 5-tap Gaussian filter along horizontal line
vec3 Horz5(vec2 pos, float off, Image tex) {
    vec3 a = Fetch(pos, vec2(-2.0, off), tex);
    vec3 b = Fetch(pos, vec2(-1.0, off), tex);
    vec3 c = Fetch(pos, vec2(0.0, off), tex);
    vec3 d = Fetch(pos, vec2(1.0, off), tex);
    vec3 e = Fetch(pos, vec2(2.0, off), tex);
    float dst = Dist(pos).x;
    
    // Convert distance to weight
    float scale = hardPix;
    float wa = Gaus(dst - 2.0, scale);
    float wb = Gaus(dst - 1.0, scale);
    float wc = Gaus(dst + 0.0, scale);
    float wd = Gaus(dst + 1.0, scale);
    float we = Gaus(dst + 2.0, scale);
    
    // Return filtered sample
    return (a*wa + b*wb + c*wc + d*wd + e*we) / (wa + wb + wc + wd + we);
}

// Scanline weight
float Scan(vec2 pos, float off) {
    float dst = Dist(pos).y;
    return Gaus(dst + off, hardScan);
}

// Three-line blend
vec3 Tri(vec2 pos, Image tex) {
    vec3 a = Horz3(pos, -1.0, tex);
    vec3 b = Horz5(pos, 0.0, tex);
    vec3 c = Horz3(pos, 1.0, tex);
    
    float wa = Scan(pos, -1.0);
    float wb = Scan(pos, 0.0);
    float wc = Scan(pos, 1.0);
    
    return a*wa + b*wb + c*wc;
}

// Screen distortion
vec2 Warp(vec2 pos) {
    pos = pos * 2.0 - 1.0;
    pos *= vec2(1.0 + (pos.y * pos.y) * warp.x, 1.0 + (pos.x * pos.x) * warp.y);
    return pos * 0.5 + 0.5;
}

// Shadow mask
vec3 Mask(vec2 pos) {
    pos.x += pos.y * 3.0;
    vec3 mask = vec3(maskDark, maskDark, maskDark);
    pos.x = fract(pos.x / 6.0);
    if (pos.x < 0.333) mask.r = maskLight;
    else if (pos.x < 0.666) mask.g = maskLight;
    else mask.b = maskLight;
    return mask;
}

// Main effect function
vec4 effect(vec4 color, Image tex, vec2 uv, vec2 screen_coords) {
    // Apply screen warp
    vec2 pos = Warp(uv);
    
    // Apply scanline effect and mask
    vec3 rgb = Tri(pos, tex) * Mask(screen_coords);
    
    // Convert back to sRGB
    rgb = ToSrgb(rgb);
    
    return vec4(rgb, Texel(tex, uv).a);
}
#endif
]])